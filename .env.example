# SIH26171 — Browser Perception Agent Environment Configuration
# NEVER commit real API keys to version control!

# Provider selection: "demo" (deterministic, offline, no API key needed) or "gemini"
AGENT_PROVIDER=demo

# Gemini API Key (only needed when AGENT_PROVIDER=gemini)
GEMINI_API_KEY=

# Gemini Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
